generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  fname         String
  lname         String
  
  username      String      @unique
  password      String
  
  isActive      Boolean     @default(true) @map("is_active")
  
  // Relations - แก้ไข relation names และ model names
  createdDataPages      DataPage[]     @relation("DataPageCreatedBy")
  updatedDataPages      DataPage[]     @relation("DataPageUpdatedBy")
  deletedDataPages      DataPage[]     @relation("DataPageDeletedBy")
  
  createdPublications   Publications[] @relation("PublicationCreatedBy")
  updatedPublications   Publications[] @relation("PublicationUpdatedBy")
  DeletedPublications   Publications[] @relation("PublicationDeletedBy")

  @@map("user")
}

model DataPage {
  id              Int       @id @default(autoincrement())
  
  name            String
  categoryNameTh  String    @map("category_name_th")
  categoryNameEn  String    @map("category_name_en")
  
  embedCode       String?    @map("embed_code")
  linkUrl         String?    @map("link_url")
  
  createBy        String       @map("create_by")
  createAt        DateTime  @default(now()) @map("create_at")
  
  updateBy        String?      @map("update_by")
  updateAt        DateTime? @updatedAt @map("update_at")

  deleteBy        String?       @map("delete_by")
  deleteAt        DateTime?     @map("delete_at")
  
  isActive        Boolean   @default(true) @map("is_active")
  
  // Relations
  createdByUser   User      @relation("DataPageCreatedBy", fields: [createBy], references: [id], onDelete: Restrict)
  updatedByUser   User?     @relation("DataPageUpdatedBy", fields: [updateBy], references: [id], onDelete: SetNull)
  deletedByUser   User?     @relation("DataPageDeletedBy", fields: [deleteBy], references: [id], onDelete: SetNull)


  // Indexes
  @@index([createBy])
  @@index([updateBy])
  @@index([isActive])
  
  @@map("data_page")
}

model Publications {
  id              Int       @id @default(autoincrement())

  titleTh         String    @map("title_th")
  titleEn         String    @map("title_en")
  
  descriptionTh   String?   @map("description_th")
  descriptionEn   String?   @map("description_en")
  
  linkUrl         String    @map("link_url")
  
  createBy        String       @map("create_by")
  createAt        DateTime  @default(now()) @map("create_at")
  
  updateBy        String?      @map("update_by")
  updateAt        DateTime? @updatedAt @map("update_at")
  
  deleteBy        String?      @map("delete_by")
  deleteAt        DateTime?   @map("delete_at")

  isActive        Boolean   @default(true) @map("is_active")
  
  // Relations - แก้ไข relation names
  createdByUser   User      @relation("PublicationCreatedBy", fields: [createBy], references: [id], onDelete: Restrict)
  updatedByUser   User?     @relation("PublicationUpdatedBy", fields: [updateBy], references: [id], onDelete: SetNull)
  deletedByUser   User?     @relation("PublicationDeletedBy", fields: [deleteBy], references: [id], onDelete: SetNull)

  // Indexes
  @@index([createBy])
  @@index([updateBy])
  @@index([isActive])
  
  @@map("publications")
}
